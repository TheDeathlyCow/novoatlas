{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}",
        "${credits}"
    ],
    "contact": {
        "homepage": "https://www.thedeathlycow.com/novoatlas/",
        "sources": "https://github.com/TheDeathlyCow/novo-atlas",
        "issues": "https://github.com/TheDeathlyCow/novo-atlas/issues"
    },
    "license": "${license}",
    "icon": "assets/novoatlas/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.thedeathlycow.novoatlas.impl.fabric.v1.NovoAtlasFabric"
        ],
        "client": [
            "com.thedeathlycow.novoatlas.impl.fabric.client.NovoAtlasClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version_predicate}",
        "java": ">=${java_version}"
    },
    "accessWidener": "${mod_id}.classtweaker",
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.thedeathlycow.com/",
                "modmenu.wiki": "https://novoatlas.thedeathlycow.com/",
                "modmenu.kofi": "https://ko-fi.com/thedeathlycow",
                "modmenu.modrinth": "https://modrinth.com/mod/novoatlas"
            }
        }
    }
}
